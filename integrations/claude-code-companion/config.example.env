# Copy this file to config.env and fill in your real values.
# Get a token from your Ourfeed instance's /automation.html page (log in, click
# "Generate API token"). Don't commit config.env anywhere.

OURFEED_URL=http://localhost:8731
OURFEED_TOKEN=REPLACE_ME

# Optional. Add a Chinese translation alongside the English original on every
# post (Ourfeed's language toggle switches between the two). Off by default,
# only turn this on if your readers actually need it, it costs one extra
# LLM call per post.
OURFEED_BILINGUAL=false

# Used by ourfeed-daemon.py (the always-on version of this script, see
# README.md), ignored if you're just running --session/--batch by hand.
# How many minutes a session file has to sit unchanged before the daemon
# treats it as "done" and extracts from it.
OURFEED_IDLE_MINUTES=15
# What time of day (24h, local time) the daemon runs the daily digest.
OURFEED_DAILY_BATCH_TIME=23:00
